plugins {
    id 'com.android.application'
    id 'com.chaquo.python'
}

android {
    namespace 'com.atv.remote'
    compileSdk 35

    defaultConfig {
        applicationId "com.atv.remote.native"
        minSdk 26
        targetSdk 35
        versionCode 2
        versionName "2.0-native"
        ndk {
            abiFilters "arm64-v8a", "x86_64"
        }
    }

    buildTypes {
        release {
            minifyEnabled false
        }
    }
}

chaquopy {
    defaultConfig {
        pip {
            install "pyatv"
            install "qrcode"
        }
    }
}
